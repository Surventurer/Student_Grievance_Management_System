# ==============================================================================
# Student Grievance Management System (SGMS) — Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` for local development:
#      cp .env.example .env
# 2. Or copy to `proud.env` for production:
#      cp .env.example proud.env
# 3. Fill in your actual values below.
# 4. NEVER commit real secret credentials to version control.
# ==============================================================================

# --- Django Core ---------------------------------------------------------------
SECRET_KEY=django-insecure-replace-with-a-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,yourdomain.com

# --- Database (PostgreSQL — Neon, Supabase, Railway, RDS, or Local) ----------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Redis & Celery & WebSockets (Channels) -----------------------------------
# When running with Docker Compose, use 'redis':
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# For local development without Docker, use localhost:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Email (SMTP for OTP & Notifications) -------------------------------------
# In dev: use 'django.core.mail.backends.console.EmailBackend' to print OTP to terminal
# In prod: use 'django.core.mail.backends.smtp.EmailBackend' with Gmail App Password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password

# --- Superuser Auto-Provisioning ----------------------------------------------
DJANGO_SUPERUSER_EMAIL=admin@university.edu
DJANGO_SUPERUSER_PASSWORD=YourStrongPassword123!
DJANGO_SUPERUSER_EMAIL_VERIFIED=True

# --- Security & Reverse Proxy -------------------------------------------------
# Set SECURE_SSL_REDIRECT=True if Django handles SSL directly; False if behind Cloudflare/Nginx
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_ALL_ORIGINS=True

# --- Upload Limits & Runtime --------------------------------------------------
MAX_UPLOAD_SIZE=10485760
PYTHON_VERSION=3.12.11
