# ==============================================================================
# Student Grievance Management System — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the `.env` file to version control.
# ==============================================================================

# --- Django Core ---------------------------------------------------------------
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL via Neon — REQUIRED) ---------------------------------
# No SQLite fallback. You MUST provide a valid PostgreSQL DATABASE_URL.
# Sign up at https://neon.tech for a free managed PostgreSQL instance.
# Format: postgres://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgres://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Email (Gmail SMTP for OTP) ------------------------------------------------
# Required for student email verification and OTP login.
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password

# --- Superuser Auto-Creation --------------------------------------------------
# Used by build.sh to create/update the superadmin on every deployment.
# Also used locally via `./build.sh` or `manage.py shell` to bootstrap admin.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-password
DJANGO_SUPERUSER_EMAIL_VERIFIED=True

# --- Security ------------------------------------------------------------------
# Set SECURE_SSL_REDIRECT=True ONLY in production behind HTTPS (e.g., on Render).
# Keep False for local development to avoid HTTPS redirect errors.
SECURE_SSL_REDIRECT=False

# --- Python Version (Render only) ----------------------------------------------
PYTHON_VERSION=3.12.11

# --- Redis / Celery (Optional) -------------------------------------------------
# Only needed if running background tasks with Celery.
# REDIS_URL=redis://localhost:6379/0
