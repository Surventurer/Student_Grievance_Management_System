# ============================================
# Student Grievance Management System
# Environment Variables
# ============================================

# Django Core
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Neon PostgreSQL) — REQUIRED, no SQLite fallback
# Format: postgres://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgres://user:pass@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Email settings (Gmail SMTP for OTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
# For Gmail, this MUST be an App Password (not your regular login password)
EMAIL_HOST_PASSWORD=your-16-character-app-password

# Superuser auto-creation (used by build.sh on Render)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-password
DJANGO_SUPERUSER_EMAIL_VERIFIED=True

# Security settings (set to True only on production with HTTPS)
SECURE_SSL_REDIRECT=False
