# ==============================================================================
# Student Grievance Management System — Environment Variables
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Fill in your actual production/local values.
# 3. IMPORTANT (Docker Compose): If your password or secret key contains a `$` sign,
#    escape it as `$$` (e.g., P@ss$$word) so Docker Compose doesn't treat it as a variable!
# 4. NEVER commit your real `.env` file to version control.
# ==============================================================================

# --- Django Core ---------------------------------------------------------------
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DEBUG=False
# In production, specify your domain or server IP, or use * for all hosts:
ALLOWED_HOSTS=localhost,127.0.0.1,*

# --- Database (PostgreSQL — REQUIRED) -----------------------------------------
# PostgreSQL connection string (Neon, Supabase, Railway, RDS, or local Postgres).
# Examples:
#   Neon:     postgres://user:pass@ep-example.neon.tech/neondb?sslmode=require
#   Railway:  postgresql://user:pass@host.railway.app:5432/railway
#   Local:    postgresql://user:pass@localhost:5432/grievance_db
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Redis & Celery & WebSockets (Channels) -----------------------------------
# When running with Docker Compose, the redis container hostname is 'redis':
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# For local development without Docker, use localhost:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Email (SMTP for OTP & Notifications) -------------------------------------
# Required for student email verification and grievance OTP submission.
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password

# --- Security & Cloudflare / Reverse Proxy -------------------------------------
# Set SECURE_SSL_REDIRECT=True only behind HTTPS (or if using Cloudflare Full SSL)
# Keep False if SSL is terminated externally or during initial testing
SECURE_SSL_REDIRECT=False

# --- CSRF Trusted Origins (Production) ----------------------------------------
# Add your production domain(s) or Cloudflare Tunnel URL here, comma-separated:
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com,http://localhost:8000

# CORS settings
CORS_ALLOW_ALL_ORIGINS=True

# --- Superuser Auto-Creation --------------------------------------------------
# Automatically creates/updates the initial superadmin on deployment
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-password
DJANGO_SUPERUSER_EMAIL_VERIFIED=True

# --- Upload Limits ------------------------------------------------------------
# Maximum attachment size in bytes (10485760 = 10MB)
MAX_UPLOAD_SIZE=10485760
