# ==============================================================================
# Student Grievance Management System — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the `.env` file to version control.
# ==============================================================================

# --- Django Core ---------------------------------------------------------------
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL — REQUIRED) -----------------------------------------
# No SQLite fallback. You MUST provide a valid PostgreSQL DATABASE_URL.
# Examples:
#   Neon:     postgres://user:pass@ep-example.neon.tech/neondb?sslmode=require
#   Railway:  postgresql://user:pass@host.railway.app:5432/railway
#   Supabase: postgresql://user:pass@host.supabase.co:5432/postgres
#   Local:    postgresql://user:pass@localhost:5432/grievance_db
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Email (Gmail SMTP for OTP) ------------------------------------------------
# Required for student email verification and OTP login.
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password

# --- Superuser Auto-Creation --------------------------------------------------
# Used by build.sh to create/update the superadmin on every deployment.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-password
DJANGO_SUPERUSER_EMAIL_VERIFIED=True

# --- Security ------------------------------------------------------------------
# Set SECURE_SSL_REDIRECT=True ONLY in production behind HTTPS.
# Keep False for local development.
SECURE_SSL_REDIRECT=False

# --- CSRF Trusted Origins (Production) ----------------------------------------
# Add your production domain(s) here, comma-separated.
# For local dev, defaults are already included in settings.py.
# Examples:
#   CSRF_TRUSTED_ORIGINS=https://my-app.onrender.com
#   CSRF_TRUSTED_ORIGINS=https://my-app.up.railway.app
#   CSRF_TRUSTED_ORIGINS=https://my-app.vercel.app,https://custom-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-production-domain.com

# --- Python Version (some hosts require this) ----------------------------------
PYTHON_VERSION=3.12.11
