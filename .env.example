# Environment variables
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Neon PostgreSQL)
# Example: postgres://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgres://user:pass@ep-restless-foo.us-east-2.aws.neon.tech/neondb?sslmode=require

# Email settings (Gmail SMTP for OTP)
# Change EMAIL_BACKEND to smtp backend for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
# For Gmail, this MUST be an App Password, not your regular login password
EMAIL_HOST_PASSWORD=your-16-character-app-password

# Redis settings (for Celery)
REDIS_URL=redis://localhost:6379/0

# File upload settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# Security settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
